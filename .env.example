# Copy to .env (never commit it) or set these in your MCP client config.
# Pick ONE auth method. Leave everything blank for anonymous (public content only).

ARCGIS_PORTAL_URL=https://www.arcgis.com   # or https://gis.yourcity.gov/portal for Enterprise

# OAuth sign-in in the browser — works with SAML / enterprise logins (recommended for orgs)
ARCGIS_CLIENT_ID=
# ARCGIS_REDIRECT_URI=http://127.0.0.1:7071/callback

# API key (developer credential) — good for read-only automation
ARCGIS_API_KEY=

# Built-in ArcGIS account (not SAML)
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Expose edit / publish / share tools. Off by default.
ARCGIS_ALLOW_WRITES=false

# Extra hosts allowed to receive your token (federated ArcGIS Server hosts), comma-separated
ARCGIS_TOKEN_HOSTS=
